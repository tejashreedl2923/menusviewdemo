<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:fitsSystemWindows="true">

    <!-- Album header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAlbumTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Album"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAlbumMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Album options"
            android:src="@android:drawable/ic_menu_more"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- Row 1 heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:text="Drawable Images"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Row 1 images -->
    <GridView
        android:id="@+id/gridDrawable"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:numColumns="3"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:scrollbars="none" />

    <!-- Row 2 heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:text="Internal Storage Images"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Row 2 images -->
    <GridView
        android:id="@+id/gridStorage"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:numColumns="3"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:scrollbars="none" />

    <!-- Row 3 heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:text="URL Images"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Row 3 images -->
    <GridView
        android:id="@+id/gridUrl"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:numColumns="3"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:scrollbars="none" />

</LinearLayout>
